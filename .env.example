# Copia este archivo a .env y rellena tus valores (.env nunca se sube a git)

# Obligatoria — genera los captions (https://console.groq.com)
GROQ_API_KEY=
# Modelo de visión de Groq (opcional). Por defecto: qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Opcional — generación de imágenes con tu cuenta de Pollinations.AI
# (sin ella funciona igual, en el nivel gratuito) https://auth.pollinations.ai
POLLINATIONS_API_KEY=
# Crear imágenes con IA (gasta saldo de Pollinations). true = activado; vacío = "en desarrollo".
IMAGE_GEN_ENABLED=

# Publicación real en Instagram — conexión por OAuth (recomendado).
# Crea una app en https://developers.facebook.com con el producto
# "Instagram API with Instagram Login" y copia aquí su ID y su secreto.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# URL pública del backend (Meta no acepta localhost). En local, un túnel:
#   npx cloudflared tunnel --url http://localhost:3001
# y pega aquí la https://….trycloudflare.com que te dé.
# En Meta, "URL de redirección de OAuth" = PUBLIC_URL + /api/instagram/callback
PUBLIC_URL=
# A dónde vuelve el navegador tras conectar (por defecto http://localhost:5173 en dev)
# APP_URL=

# ─── Cuentas de usuario ─────────────────────────────────────────────────────
# Clave para firmar las sesiones. OBLIGATORIA en producción (una cadena larga
# y aleatoria). En local, si la dejas vacía se genera una en server/data.
JWT_SECRET=
# Clave para cifrar los tokens de Instagram en la base de datos. Obligatoria en
# producción. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guárdala bien: si se pierde, cada usuario tendrá que reconectar Instagram.
TOKEN_ENC_KEY=
# Registro de cuentas nuevas: true (abierto) o false (cerrado).
ALLOW_SIGNUP=true
# Si pones un código, hará falta para crear cuenta (útil para invitar clientes).
INVITE_CODE=

# ─── Base de datos ──────────────────────────────────────────────────────────
# Vacía en local → se usa PGlite (Postgres embebido en server/data/pglite).
# En producción, la URL de PostgreSQL (p. ej. la que da Railway).
DATABASE_URL=
# PGSSL=true si tu Postgres exige SSL desde fuera (URL pública de Railway)
# PGSSL=

# Opcional — puerto del backend (por defecto 3001)
PORT=3001
