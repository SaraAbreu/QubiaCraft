# Copia este archivo a .env y rellena tus valores (.env nunca se sube a git)

# Obligatoria — genera los captions (https://console.groq.com)
GROQ_API_KEY=

# Opcional — generación de imágenes con tu cuenta de Pollinations.AI
# (sin ella funciona igual, en el nivel gratuito) https://auth.pollinations.ai
POLLINATIONS_API_KEY=

# Publicación real en Instagram — conexión por OAuth (recomendado).
# Crea una app en https://developers.facebook.com con el producto
# "Instagram API with Instagram Login" y copia aquí su ID y su secreto.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# URL pública del backend (Meta no acepta localhost). En local, un túnel:
#   npx cloudflared tunnel --url http://localhost:3001
# y pega aquí la https://….trycloudflare.com que te dé.
# En Meta, "URL de redirección de OAuth" = PUBLIC_URL + /api/instagram/callback
PUBLIC_URL=
# A dónde vuelve el navegador tras conectar (por defecto http://localhost:5173 en dev)
# APP_URL=

# Modo antiguo (opcional): token fijo en lugar de OAuth. Sin nada, modo demo.
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=

# Opcional — puerto del backend (por defecto 3001)
PORT=3001
