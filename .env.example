# Copia este archivo a .env y rellena tus valores (.env nunca se sube a git)

# Obligatoria — genera los captions (https://console.groq.com)
GROQ_API_KEY=

# Opcional — generación de imágenes con tu cuenta de Pollinations.AI
# (sin ella funciona igual, en el nivel gratuito) https://auth.pollinations.ai
POLLINATIONS_API_KEY=

# Opcionales — publicación real en Instagram (sin ellas, modo demo)
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=

# Opcional — puerto del backend (por defecto 3001)
PORT=3001
